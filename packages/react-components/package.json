{
  "name": "@uoguelph/react-components",
  "version": "1.10.4",
  "description": "University of Guelph React Components Library",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production vite build",
    "watch": "cross-env NODE_ENV=development vite build --watch",
    "prepack": "npm run build"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./style": "./dist/index.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/"
      ]
    }
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "html-react-parser": "^6.1.9",
    "object-hash": "^3.0.0",
    "react": "^19.3.1",
    "react-animate-height": "^3.2.4",
    "react-dom": "^19.3.1",
    "react-transition-group": "^4.4.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@awesome.me/kit-7993323d0c": "^1.0.11",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@uoguelph/tailwind-theme": "*",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "nanoid": "^6.0.2",
    "object-hash": "^3.0.0",
    "postcss": "^8.5.32",
    "rollup-preserve-directives": "^1.1.3",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgr": "^5.2.0"
  },
  "license": "0BSD",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccswbs/uofg-components.git"
  },
  "bugs": {
    "url": "https://github.com/ccswbs/uofg-components/issues"
  },
  "gitHead": "1739053a285cefe8d0bdbbff15686f64812c78eb"
}
